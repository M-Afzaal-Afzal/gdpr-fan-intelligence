DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fan_intelligence
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# LLM provider: stub | openai | gemini | anthropic | ollama | huggingface | fireworks
LLM_PROVIDER=stub

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini (Google)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic / Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-haiku-20240307
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Ollama (local — no key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# HuggingFace Inference API
HF_API_KEY=
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# HF_BASE_URL=https://api-inference.huggingface.co/models

# Fireworks AI (OpenAI-compatible — https://fireworks.ai/models)
FIREWORKS_API_KEY=
# FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
